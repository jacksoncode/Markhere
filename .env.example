# Markhere Environment Variables

# ===== Sentry Error Tracking =====
# Get your DSN from https://sentry.io/
# Leave empty to disable error tracking
VITE_SENTRY_DSN=

# ===== Application Version =====
# Automatically set by package.json, but can be overridden
# VITE_APP_VERSION=0.4.9

# ===== Development Settings =====
# VITE_DEBUG_MODE=true

# ===== API Keys (Future use) =====
# VITE_AI_API_KEY=
# VITE_LANGUAGETOOL_API_KEY=
